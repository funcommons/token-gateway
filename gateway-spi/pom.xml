<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-gateway</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- JaCoCo 门禁: 实测 80.0% (2026-09-02 提升后) -->
    <properties>
        <jacoco.line.min>0.77</jacoco.line.min>
    </properties>

    <artifactId>gateway-spi</artifactId>
    <name>gateway-spi</name>
    <description>
        token-gateway 能力面 SPI (M0 接口先行, 冻结契约):
        BackendAdapter + Capability + 七能力面接口 + task 委托面 + contract DTO + 能力面配置模型.
        适配器只依赖本模块, 不依赖网关核心; 三方按 docs/开发文档/02_后端接入开发手册.md
        实现 HTTP 契约时无需依赖本模块 (openapi 通用适配器路径).
    </description>

    <dependencies>
        <!-- SPI 接口全部响应式 (Mono) -->
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>

        <!-- Lombok (contract DTO) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
