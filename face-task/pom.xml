<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-gateway</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>face-task</artifactId>
    <name>face-task</name>
    <description>
        token-gateway 任务面 (face=task 部署分组, 规划中 M2.5 —— THMP 任务域移植):
        四模态 create/poll/notify/资源代理 + 轮询状态机 + 调度兜底.
        本模块独占数据库依赖 (任务表, THMP 17 号 DDL) 与资源缓存盘;
        face=llm 部署不引入本模块任何存储依赖.
    </description>

    <dependencies>
        <dependency>
            <groupId>fun.commons</groupId>
            <artifactId>gateway-core</artifactId>
        </dependency>

        <!-- M2.5: 任务表持久化 (PostgreSQL, THMP 17 号 DDL) 依赖在本模块引入,
             gateway-core / face-llm 保持零 JDBC -->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
