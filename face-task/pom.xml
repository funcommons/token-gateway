<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-gateway</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- JaCoCo 门禁: 实测 75.0% (2026-09-02 提升后) -->
    <properties>
        <jacoco.line.min>0.72</jacoco.line.min>
    </properties>

    <artifactId>face-task</artifactId>
    <name>face-task</name>
    <description>
        token-gateway 任务面 (face=task 部署分组, 规划中 M2.5):
        四模态 caller 端点 + 计费 saga + notify + 资源代理 + LotaskTaskClient.
        任务状态由 lotask4j 平台托管 (05_任务面lotask4j托管方案, 2026-09-01 决议) —
        本模块无数据库依赖, 仅保留资源缓存盘;
        状态机/重试/僵尸回收/调度兜底全部在 lotask4j 侧.
    </description>

    <dependencies>
        <dependency>
            <groupId>fun.commons</groupId>
            <artifactId>gateway-core</artifactId>
        </dependency>

        <!-- M2.5: lotask4j 客户端 (WebClient, jwt + HMAC 签名) 在本模块实现;
             无 JDBC —— 任务状态托管在 lotask4j 平台 -->

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
