<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>fun.commons</groupId>
        <artifactId>token-gateway</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- JaCoCo 门禁: 装配壳仅 3 行, 豁免 -->
    <properties>
        <jacoco.line.min>0.0</jacoco.line.min>
    </properties>

    <artifactId>token-gateway-app</artifactId>
    <name>token-gateway-app</name>
    <description>
        token-gateway 装配应用: gateway-core + face-llm + face-task,
        token-gateway.face = llm | task | all 部署分组 (同 jar 异配置, 设计方案 §9).
    </description>

    <dependencies>
        <!-- face 装配 (face 条件由 FaceLlmAssembly / FaceTaskAssembly 控制) -->
        <dependency>
            <groupId>fun.commons</groupId>
            <artifactId>face-llm</artifactId>
        </dependency>
        <dependency>
            <groupId>fun.commons</groupId>
            <artifactId>face-task</artifactId>
        </dependency>

        <!-- WebFlux + Netty (无 servlet 容器) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- Redis (限流 / 幂等 / 缓存, 共享单体 Redis 实例) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 健康检查 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>fun.commons.tokengateway.app.TokenGatewayApplication</mainClass>
                </configuration>
            </plugin>
            <!-- 覆盖率度量 (JaCoCo): 报告落 target/site/jacoco -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.13</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
